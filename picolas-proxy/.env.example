# ==========================================
# Picolas Proxy — variables de entorno
# ==========================================
# Copia este archivo como ".env" para desarrollo local.
# En Render, define estas variables desde el dashboard (Environment).

# Puerto del panel web (Render lo asigna automáticamente vía PORT).
PORT=3000

# Usuario y contraseña del panel de administración.
# OBLIGATORIO cambiar esto antes de exponer el servicio.
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=change-me-please

# Secreto usado para firmar las cookies de sesión del panel.
# Genera uno propio, por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# Si es "true", permite que los servidores proxy (HTTP/SOCKS5) escuchen en
# 0.0.0.0 en vez de sólo en la interfaz local/LAN. Por defecto está en false
# para evitar crear un proxy público abierto por accidente.
ALLOW_EXTERNAL_PROXY=false

# Entorno de ejecución.
NODE_ENV=production
